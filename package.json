{
  "name": "matthewshera-com",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio of Matthew Shera \u2014 game director & systems designer.",
  "type": "module",
  "scripts": {
    "dev": "eleventy --serve --port=8080",
    "build": "rm -rf _site && eleventy && node scripts/minify.mjs",
    "og": "rm -rf _site && OG=1 eleventy && node scripts/og.mjs && rm -rf _site",
    "check": "html-validate \"_site/**/*.html\"",
    "shots": "node scripts/shots.mjs http://127.0.0.1:8089 .scratch/shots-static static",
    "clean": "rm -rf _site",
    "resume": "rm -rf _site && eleventy && node scripts/resume.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "esbuild": "^0.25.12",
    "gsap": "^3.13.0",
    "html-validate": "^9.6.0",
    "lenis": "^1.3.4",
    "playwright-core": "^1.55.0"
  }
}