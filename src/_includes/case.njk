---
layout: base.njk
---
{% set arrow %}<svg class="arrow-link__icon" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13L13 3M13 3H5M13 3V11" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endset %}
{% set works = collections.work %}
{% set idx = 0 %}
{% for w in works %}{% if w.data.slug == slug %}{% set idx = loop.index %}{% endif %}{% endfor %}
{% set nextItem = works[idx % works.length] %}
{% set nextIdx = (idx % works.length) + 1 %}

<article class="case">
  <header class="case-hero wrap" data-hero-root>
    <div class="case-hero__eyebrow mono" data-reveal data-hero>
      <span>Case study {{ idx | pad }} / {{ works.length | pad }}</span>
      <span>{{ studio }}</span>
    </div>
    <h1 class="case-hero__title display-xl" data-split data-hero>{{ title }}</h1>
    <p class="case-hero__lede lede" data-reveal data-hero>{{ lede }}</p>

    <dl class="case-meta" data-reveal data-hero>
      <div><dt>Role</dt><dd>{{ role }}</dd></div>
      <div><dt>Studio</dt><dd>{{ studio }}</dd></div>
      <div><dt>Years</dt><dd>{{ years }}</dd></div>
      <div><dt>Platform</dt><dd>{{ platform }}</dd></div>
      <div><dt>Disciplines</dt><dd>{{ disciplines }}</dd></div>
    </dl>

    {% if heroImage %}
    <figure class="case-plate" data-fade>
      <img src="{{ heroImage }}"{% if heroSrcset %} srcset="{{ heroSrcset }}" sizes="100vw"{% endif %} alt="{{ heroAlt }}" width="1920" height="1080" fetchpriority="high" decoding="async">
    </figure>
    {% elif diagram %}
    <figure class="case-plate case-plate--diagram" data-fade>
      {% include "diagrams/" + diagram + ".njk" %}
    </figure>
    {% endif %}
    {% if heroCaption %}<p class="case-plate-caption" data-reveal>{{ heroCaption }}</p>{% endif %}
  </header>

  <div class="wrap">
    {{ content | safe }}
  </div>

  <section class="case-next wrap">
    <a href="{{ nextItem.url }}" data-transition data-cursor="view">
      <span class="mono" data-reveal>Next — {{ nextIdx | pad }} / {{ works.length | pad }}</span>
      <span class="case-next__title" data-split>{{ nextItem.data.title }}</span>
      <p class="case-next__sub" data-reveal>{{ nextItem.data.summary }}</p>
    </a>
  </section>
</article>
