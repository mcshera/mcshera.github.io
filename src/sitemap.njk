---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in collections.all %}{% if p.url and not p.data.eleventyExcludeFromCollections %}
  <url><loc>{{ p.url | abs(site.url) }}</loc><lastmod>{{ '' | isoDate }}</lastmod></url>
{%- endif %}{% endfor %}
</urlset>
