{
  "extends": [
    "html-validate:recommended"
  ],
  "rules": {
    "no-inline-style": "off",
    "require-sri": "off",
    "no-trailing-whitespace": "off",
    "long-title": "off",
    "attribute-boolean-style": "off",
    "svg-focusable": "off",
    "prefer-native-element": "off",
    "wcag/h30": "off",
    "text-content": "off"
  }
}